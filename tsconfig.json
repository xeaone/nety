{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        // "rootDir": "src",
        // "outDir": "dist",
        "types": ["node"],
        "declaration": true,
        "sourceMap": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "noEmitOnError": true,
        "strict": true,
        "erasableSyntaxOnly": true
    }
    // "include": ["src/**/*.ts"],
    // "exclude": ["node_modules", "dist"]
}
